<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>簽收 | ACES </title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div class="page-bg">
    <main class="app-shell">
      <header class="brand-header">
        <div class="brand-mark">ACES <span>DTD</span></div>
        <h1>簽收掃碼</h1>
        <p>HR 交付現金專用</p>
      </header>

      <div class="page-body">
        <!-- 1. 輸入簽收人（HR）工號 -->
        <section id="loginView" class="card">
          <span class="eyebrow">HR</span>
          <h2>請輸入您的工號</h2>
          <p class="lead">系統會記錄簽收人與簽收時間。</p>
          <label class="field-label" for="signerInput">工號</label>
          <input id="signerInput" class="input" type="text" placeholder="例如：T12345" autocomplete="off" autocapitalize="characters" />
          <p id="signerError" class="error-text"></p>
          <button id="startBtn" class="primary-btn">開始簽收</button>
        </section>

        <!-- 2. 掃領取碼 -->
        <section id="scanView" hidden>
          <div class="operator-bar">
            <span>簽收人：<strong id="signerLabel"></strong></span>
            <button id="changeSignerBtn" class="link-btn" type="button">更換工號</button>
          </div>

          <div class="scan-box"><video id="video" playsinline muted></video></div>
          <p class="scan-hint">請掃描員工出示的領取碼，掃完即視為已交付現金</p>
          <p id="scanError" class="scan-error" hidden></p>

          <div class="manual-box">
            <button id="manualToggle" class="link-btn" type="button">無法掃描？手動輸入領取碼</button>
            <form id="manualForm" class="manual-form" hidden>
              <input id="manualInput" class="input" type="text" placeholder="16 碼領取碼" autocomplete="off" />
              <button class="primary-btn" type="submit">簽收</button>
            </form>
          </div>
        </section>

        <!-- 3. 結果 -->
        <section id="resultView" class="card center" hidden>
          <div id="resultIcon" class="status-icon">✓</div>
          <h2 id="resultTitle"></h2>
          <dl id="resultInfo" class="info-list" style="text-align:left"></dl>
          <button id="nextBtn" class="primary-btn">掃下一位</button>
        </section>
      </div>

      <footer>© 2026 ACES DTD. ALL RIGHTS RESERVED.</footer>
    </main>
  </div>

  <script src="js/vendor/jsQR.js"></script>
  <script src="js/config.js"></script>
  <script src="js/mock-api.js"></script>
  <script src="js/ui.js"></script>
  <script src="js/scanner.js"></script>
  <script src="js/sign.js"></script>
</body>
</html>
